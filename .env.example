# ============================================================
# RetailOPS-MCP  –  Environment Configuration Template
# Copy this file to .env in each sub-directory OR set these
# variables at the system/shell level.
# ============================================================

# ── LLM / API ───────────────────────────────────────────────
# OpenRouter API key (used by all four MCP servers + NLP interface)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# (Optional) OpenRouter model to use.
# Default: meta-llama/llama-3.1-8b-instruct
# Other options: mistralai/mistral-7b-instruct, openai/gpt-4o-mini, etc.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# (Optional) Groq API key – only needed if using Groq-backed tools
GROQ_API_KEY=your-groq-api-key-here

# ── Retail Context Defaults ──────────────────────────────────
# These only affect stapp.py (the non-interactive version).
# The fully-interactive stapp_hardcoded1.py sets these via sidebar.
RETAILOPS_STORE=Mumbai Flagship Store
RETAILOPS_DEFAULT_PRODUCT=Samsung TV
RETAILOPS_DEFAULT_DAYS=30
